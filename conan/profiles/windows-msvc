[settings]
os=Windows
arch=x86_64
build_type=Release
compiler=msvc
compiler.version=194
compiler.cppstd=23
compiler.runtime=static
compiler.runtime_type=Release

# Debug builds must also override compiler.runtime_type=Debug, or the CRT
# mismatches.

[conf]
tools.cmake.cmaketoolchain:generator=Ninja

# CI runs windows-2022, which ships Visual Studio 17 (MSVC 19.4x). Without this
# the recipe generator fails with "VS non-existing installation: Visual Studio 18",
# because a bare compiler.version is read as a Visual Studio generation number.
# Locally, where the toolset is VS 18, override to 195 on the command line.
tools.microsoft.msbuild:vs_version=17
