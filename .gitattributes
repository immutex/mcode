# Normalize to LF in the repository; check out native where it matters.
* text=auto eol=lf

# Windows-only scripts must keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets.
*.png binary
*.ico binary
*.icns binary
*.exe binary
*.dll binary
*.lib binary

# Generated / vendored code is excluded from language stats.
docs/** linguist-documentation
